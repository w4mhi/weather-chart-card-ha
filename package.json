  "description": "Enhanced weather chart card with temperature gradients, timezone support, and customizable layouts for Home Assistant",
  "type": "module",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards",
    "weather",
    "chart",
    "forecast"
  ],
  "module": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/w4mhi/weather-chart-card-ha.git"
  },
  "bugs": {
    "url": "https://github.com/w4mhi/weather-chart-card-ha/issues"
  },
  "homepage": "https://github.com/w4mhi/weather-chart-card-ha#readme",
  "author": "Marc Lamberts, enhanced by Mihai",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "lit": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "~1.56.1",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-serve": "^2.0.3"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "npm run lint && npm run rollup",
